{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ariane",
  "mainBinaryName": "ariane",
  "version": "0.8.16",
  "identifier": "fr.ariane.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Ariane",
        "width": 1400,
        "height": 880,
        "minWidth": 960,
        "minHeight": 560,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "rpm",
      "deb",
      "nsis",
      "msi"
    ],
    "category": "Utility",
    "shortDescription": "Ariane, explorateur de fichiers coloré",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "rpm": {
        "desktopTemplate": "ariane.desktop"
      },
      "deb": {
        "desktopTemplate": "ariane.desktop"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkwQTU4QTg4NjBBMjAzOEMKUldTTUE2SmdpSXFsa055bHkvUWFkY3c4eHdPNk41Q1JIYno3L1lmNndFOXRtL3BxNytYT2NQd3AK",
      "endpoints": [
        "https://github.com/Akemine/ariane/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
